# 仓库内统一用 LF 存储，检出时按平台自动转换
* text=auto eol=lf

# Windows 批处理必须用 CRLF，否则可能执行异常
*.bat text eol=crlf

# Shell 脚本必须用 LF
*.sh text eol=lf

# 源代码与文档统一 LF
*.cpp text eol=lf
*.h   text eol=lf
*.md  text eol=lf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.pdf binary